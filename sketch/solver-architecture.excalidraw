      "id": "Meq2vNhuCOgjYH81UNEDj",
      "type": "text",
      "x": 3251.995987921975,
      "y": -798.7978874568615,
      "width": 1108.3452786449477,
      "height": 1875,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2f",
      "roundness": null,
      "seed": 932223155,
      "version": 6422,
      "versionNonce": 1889874273,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791382244798,
      "created": 1791299262853,
      "link": null,
      "locked": false,
      "text": "import yag_model as yag\nfrom yag_model import geometric_step, fixed_time_brake, stride_trigger, in_memory_sink, model_params\nimport yag_utils.channels\nimport yag_utils.initial_conditions as yag_ics\n\nconfig = yag.solver_config(\n\n    # default discretization\n    disc = yag.discretization(\n        # 40 x 40 discrete values\n        mesh_resolution=(40, 40),\n        # model 1 μm^2\n        physical_size = (1e-6, 1e-6)\n    )\n\n    # step by 1 μs exponentially increasing at a slow rate\n    # (default is fixed_step(dt = 1.0))\n    step = geometric_step(dt_0 = 1e-6, r = 1.001),\n\n    # stop after 100 seconds\n    # (default is fixed_step_brake(last_step = 100) frames)\n    brake = fixed_time_brake(final_time = 1e2),\n\n    capt = yag.capture_config(\n        # (yag.reducers.concentration_field() by default)\n        # Other valid examples include:\n        # yag.reducers.total_mass()\n        # yag.reducers.total_molar_quantity()\n        reducer = yag.reducers.density_field()\n\n        # capture every 1000 frames\n        # (stride_trigger(every = 1) by default)\n        trigger = stride_trigger(every = 1000)\n\n        # store first 250 frames & moments of time\n        # (in_memory_sink by default without capacity, arbitrarily large)\n        sink = in_memory_sink(capacity = 250)\n\n        # Only store YAG & YAM channels, ignore Al203, Y2O3, YAP\n        # (collects all channels by default)\n        # YAG, YAM - defined constants, bit flags relating to element index\n        channels = YAM | YAG\n    ),\n\n    # (default is the derived stochiometry matrix S from thesis)\n    stoichiometry = yag_utils.stoichiometry.simplified\n)\n\nsmallest_possible_config = yag.solver_config()\n\ninitial_condition = yag_ics.random_squares(\n    disc = config.discretization,\n    c1 = 0.1 # concentration value of channel 1\n    c2 = 0.2 # concentration value of channel 2\n)\n\nparams = model_params(\n    D = [1e-5, 1e-5, 1e-5, 1e-5, 1e-5],\n    k = [20.0, 30.0, 40.0]\n)\n\nresult = yag.solve(config, ic, params)\n\n# result allows us to read in batches\nfor c, t in result.iter(batch_size = 100):\n    # do something with the data\n    pass\n\n# or read all at once\nc, t = result.all()\n\n# when working with files we can create result for files\nresult = yag.hdf5_result('result_file.hdf5')\n\nand similarly we can read in batches or all at once.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import yag_model as yag\nfrom yag_model import geometric_step, fixed_time_brake, stride_trigger, in_memory_sink, model_params\nimport yag_utils.channels\nimport yag_utils.initial_conditions as yag_ics\n\nconfig = yag.solver_config(\n\n    # default discretization\n    disc = yag.discretization(\n        # 40 x 40 discrete values\n        mesh_resolution=(40, 40),\n        # model 1 μm^2\n        physical_size = (1e-6, 1e-6)\n    )\n\n    # step by 1 μs exponentially increasing at a slow rate\n    # (default is fixed_step(dt = 1.0))\n    step = geometric_step(dt_0 = 1e-6, r = 1.001),\n\n    # stop after 100 seconds\n    # (default is fixed_step_brake(last_step = 100) frames)\n    brake = fixed_time_brake(final_time = 1e2),\n\n    capt = yag.capture_config(\n        # (yag.reducers.concentration_field() by default)\n        # Other valid examples include:\n        # yag.reducers.total_mass()\n        # yag.reducers.total_molar_quantity()\n        reducer = yag.reducers.density_field()\n\n        # capture every 1000 frames\n        # (stride_trigger(every = 1) by default)\n        trigger = stride_trigger(every = 1000)\n\n        # store first 250 frames & moments of time\n        # (in_memory_sink by default without capacity, arbitrarily large)\n        sink = in_memory_sink(capacity = 250)\n\n        # Only store YAG & YAM channels, ignore Al203, Y2O3, YAP\n        # (collects all channels by default)\n        # YAG, YAM - defined constants, bit flags relating to element index\n        channels = YAM | YAG\n    ),\n\n    # (default is the derived stochiometry matrix S from thesis)\n    stoichiometry = yag_utils.stoichiometry.simplified\n)\n\nsmallest_possible_config = yag.solver_config()\n\ninitial_condition = yag_ics.random_squares(\n    disc = config.discretization,\n    c1 = 0.1 # concentration value of channel 1\n    c2 = 0.2 # concentration value of channel 2\n)\n\nparams = model_params(\n    D = [1e-5, 1e-5, 1e-5, 1e-5, 1e-5],\n    k = [20.0, 30.0, 40.0]\n)\n\nresult = yag.solve(config, ic, params)\n\n# result allows us to read in batches\nfor c, t in result.iter(batch_size = 100):\n    # do something with the data\n    pass\n\n# or read all at once\nc, t = result.all()\n\n# when working with files we can create result for files\nresult = yag.hdf5_result('result_file.hdf5')\n\nand similarly we can read in batches or all at once.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
