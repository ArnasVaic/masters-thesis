    },
    {
      "id": "6jSvuynrP0nD7q6Gc-lz5",
      "type": "text",
      "x": 606.1119625672288,
      "y": 1253.4748285252058,
      "width": 652.7140720330773,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b34",
      "roundness": null,
      "seed": 1653539421,
      "version": 1965,
      "versionNonce": 1318534589,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791302020710,
      "created": 1791300955440,
      "link": null,
      "locked": false,
      "text": "is there any point in actually aggregating by anything other than\nsum? What's the point of collecting maximal/minimal/average molar\nquantity/molar concentration? Are any of these combinations\nlegit? Because instead of total we get aggregated value of a\nsingle discrete cell like average discrete cell concentration /\nquantity / density... I'm not sure how anyone would find these\nvalues useful, but maybe? The more close we get to a perfect\ndiscretization (e. g. mesh resolution -> inf) the more these values\ngo to 0 and then numerical problems start so maybe there is not\npoint...\n\nSay we want to calculate some value for which we need the entire\nconcentration like concentration at a specific point (x, y). Here\nflexibility of arbitrary reduction method would help but this use\ncase is very improbable and still possible with current setup if we\nconfigure an appropriate time step",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "is there any point in actually aggregating by anything other than sum? What's the point of collecting maximal/minimal/average molar quantity/molar concentration? Are any of these combinations legit? Because instead of total we get aggregated value of a single discrete cell like average discrete cell concentration / quantity / density... I'm not sure how anyone would find these values useful, but maybe? The more close we get to a perfect discretization (e. g. mesh resolution -> inf) the more these values go to 0 and then numerical problems start so maybe there is not point...\n\nSay we want to calculate some value for which we need the entire concentration like concentration at a specific point (x, y). Here flexibility of arbitrary reduction method would help but this use case is very improbable and still possible with current setup if we\nconfigure an appropriate time step",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
