    {
      "id": "Meq2vNhuCOgjYH81UNEDj",
      "type": "text",
      "x": 1444.4384144702701,
      "y": 594.8310271068502,
      "width": 1108.3452786449477,
      "height": 1525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2f",
      "roundness": null,
      "seed": 932223155,
      "version": 5416,
      "versionNonce": 814483539,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791307745389,
      "created": 1791299262853,
      "link": null,
      "locked": false,
      "text": "import yag_model as yag\nfrom yag_model import geometric_step, fixed_time_brake, stride_trigger, in_memory_sink, model_params\nimport yag_utils.channels\nimport yag_utils.initial_conditions as yag_ics\n\nconfig = yag.solver_config(\n\n    # default discretization\n    disc = yag.discretization(\n        # 40 x 40 discrete values\n        mesh_resolution=(40, 40),\n        # model 1 μm^2\n        physical_size = (1e-6, 1e-6)\n    )\n\n    # step by 1 μs exponentially increasing at a slow rate\n    # (default is fixed_step(dt = 1.0))\n    step = geometric_step(dt_0 = 1e-6, r = 1.001),\n\n    # stop after 100 seconds\n    # (default is fixed_step_brake(last_step = 100) frames)\n    brake = fixed_time_brake(final_time = 1e2),\n\n    capt = yag.capture_config(\n        # (None by default)\n        # maybe others are defined like aggregate_at_point(row, col)\n        # or aggregate_mass() or aggregate_quantity()\n        aggregate = aggregate_sum()\n\n        # capture every 1000 frames\n        # (stride_trigger(every = 1) by default)\n        trigger = stride_trigger(every = 1000)\n\n        # store first 250 frames & moments of time\n        # (in_memory_sink by default without capacity, arbitrarily large)\n        sink = in_memory_sink(capacity = 250)\n\n        # Only store YAG & YAM channels, ignore Al203, Y2O3, YAP\n        # (collects all channels by default)\n        # YAG, YAM - defined constants, bit flags relating to element index\n        channels = YAM | YAG\n    ),\n\n    # (default is the derived stochiometry matrix S from thesis)\n    stoichiometry = yag_utils.stoichiometry.simplified\n)\n\nsmallest_possible_config = yag.solver_config()\n\nic = yag_ics.random_squares(config.discretization)\n\nparams = model_params(\n    D = [1e-5, 1e-5, 1e-5, 1e-5, 1e-5],\n    k = [20.0, 30.0, 40.0]\n)\n\nyag.solve(config, ic, params)\n\n# when using in_memory_sink we can access sink fields directly\nc, t = config.capture.sink.read()\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import yag_model as yag\nfrom yag_model import geometric_step, fixed_time_brake, stride_trigger, in_memory_sink, model_params\nimport yag_utils.channels\nimport yag_utils.initial_conditions as yag_ics\n\nconfig = yag.solver_config(\n\n    # default discretization\n    disc = yag.discretization(\n        # 40 x 40 discrete values\n        mesh_resolution=(40, 40),\n        # model 1 μm^2\n        physical_size = (1e-6, 1e-6)\n    )\n\n    # step by 1 μs exponentially increasing at a slow rate\n    # (default is fixed_step(dt = 1.0))\n    step = geometric_step(dt_0 = 1e-6, r = 1.001),\n\n    # stop after 100 seconds\n    # (default is fixed_step_brake(last_step = 100) frames)\n    brake = fixed_time_brake(final_time = 1e2),\n\n    capt = yag.capture_config(\n        # (None by default)\n        # maybe others are defined like aggregate_at_point(row, col)\n        # or aggregate_mass() or aggregate_quantity()\n        aggregate = aggregate_sum()\n\n        # capture every 1000 frames\n        # (stride_trigger(every = 1) by default)\n        trigger = stride_trigger(every = 1000)\n\n        # store first 250 frames & moments of time\n        # (in_memory_sink by default without capacity, arbitrarily large)\n        sink = in_memory_sink(capacity = 250)\n\n        # Only store YAG & YAM channels, ignore Al203, Y2O3, YAP\n        # (collects all channels by default)\n        # YAG, YAM - defined constants, bit flags relating to element index\n        channels = YAM | YAG\n    ),\n\n    # (default is the derived stochiometry matrix S from thesis)\n    stoichiometry = yag_utils.stoichiometry.simplified\n)\n\nsmallest_possible_config = yag.solver_config()\n\nic = yag_ics.random_squares(config.discretization)\n\nparams = model_params(\n    D = [1e-5, 1e-5, 1e-5, 1e-5, 1e-5],\n    k = [20.0, 30.0, 40.0]\n)\n\nyag.solve(config, ic, params)\n\n# when using in_memory_sink we can access sink fields directly\nc, t = config.capture.sink.read()\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
